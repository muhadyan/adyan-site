# Short tag links for Threads. Each adds UTM tags so Umami shows the source.
# The "." rows catch a link that swallows the full stop after it.
# /p/<code>: one code per pitch, so a visit can be traced to the pitch that sent it.
/p   /?utm_source=threads&utm_medium=pitch  302
/p.  /?utm_source=threads&utm_medium=pitch  302
/p/:code  /?utm_source=threads&utm_medium=pitch&utm_content=:code  302
/b   /?utm_source=threads&utm_medium=bio    302
/b.  /?utm_source=threads&utm_medium=bio    302
