---
// 1200x630 link-preview card of the class page. `bun run og kelas` screenshots it into
// public/og-kelas.png. Text only, no photo. Not linked, not indexed.
import "../../styles/global.css";
import { SITE } from "../../config";
import { kelas } from "../../content/kelas";

const { hero } = kelas;
// "AI untuk Kerja · Kelas gratis 12 Des" -> the second half sits under the title.
const tagline = kelas.meta.title.split(" · ")[1];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG</title>
  </head>
  <body>
    <main class="card">
      <div class="text">
        <p class="name">{SITE.name}</p>
        <h1>{hero.title}</h1>
        <p class="tagline">{tagline}</p>
        <p class="subtitle">{hero.subtitle}</p>
        <p class="url num">adyan.admos.id/kelas</p>
      </div>
      <ul class="slip num">
        {hero.chips.map((chip) => <li>{chip}</li>)}
      </ul>
    </main>
  </body>
</html>

<style>
  body {
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }

  .card {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 56px;
    align-items: center;
    height: 100%;
    padding: 0 72px;
    border-bottom: 14px solid var(--ledger);
  }

  .text {
    display: grid;
    gap: 18px;
  }

  .name {
    font-weight: 700;
    font-size: 26px;
    font-variation-settings: "wdth" 118;
  }

  h1 {
    font-size: 96px;
    font-variation-settings: "wdth" 125;
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .tagline {
    justify-self: start;
    padding: 6px 14px;
    border-radius: var(--radius);
    background: var(--ledger);
    color: #fff;
    font-weight: 700;
    font-size: 34px;
    font-variation-settings: "wdth" 118;
  }

  .subtitle {
    max-width: 30ch;
    color: var(--ink-soft);
    font-size: 28px;
    line-height: 1.3;
  }

  .url {
    color: var(--ledger);
    font-size: 22px;
  }

  /* The class facts as entries on a ledger slip, closed with the accountant's double rule. */
  .slip {
    display: grid;
    padding: 28px 32px 32px;
    list-style: none;
    background: var(--slip);
    border: 1px solid var(--rule);
    border-left: 4px double var(--ledger);
    border-radius: var(--radius);
    box-shadow: 0 18px 36px rgb(27 36 32 / 0.12);
    font-size: 24px;
    font-weight: 600;
    rotate: 1.5deg;
  }

  .slip li {
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }

  .slip li:first-child {
    color: var(--ledger);
  }

  .slip li:last-child {
    border-bottom: 3px double var(--ink);
  }
</style>
