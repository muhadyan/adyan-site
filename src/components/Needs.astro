---
import type { Copy } from "../content/types";

interface Props {
  needs: Copy["needs"];
}

const { needs } = Astro.props;
---

<section class="section" aria-labelledby="needs-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="needs-title">{needs.title}</h2>
      <p>{needs.intro}</p>
    </div>
    <table class="ledger">
      <thead>
        <tr>
          <th scope="col">{needs.columns.need}</th>
          <th scope="col">{needs.columns.build}</th>
          <th scope="col">{needs.columns.proof}</th>
        </tr>
      </thead>
      <tbody>
        {
          needs.rows.map((row) => (
            <tr>
              {/* Labels repeat the (hidden) column headers once the table stacks on phones.
                  aria-hidden: screen readers already announce the real headers. */}
              <th scope="row">
                <span class="cell-label" aria-hidden="true">
                  {needs.columns.need}
                </span>
                <q>{row.need}</q>
              </th>
              <td>
                <span class="cell-label" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5v14" />
                    <path d="m19 12-7 7-7-7" />
                  </svg>
                  {needs.columns.build}
                </span>
                {row.build}
              </td>
              <td class="proof">
                <span class="cell-label" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  {needs.columns.proof}:
                </span>
                {row.proof}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .ledger {
    width: 100%;
    border-collapse: collapse;
    /* Double vertical rule at the left, as on an accounting pad. */
    border-left: 3px double var(--ledger);
  }

  thead th {
    padding: 0 16px 12px;
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-weight: 500;
    text-align: left;
    border-bottom: 1px solid var(--ink);
  }

  tbody th,
  tbody td {
    padding: 18px 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
  }

  tbody th {
    width: 30%;
    font-weight: 650;
    font-size: var(--step-1);
    line-height: 1.25;
    font-variation-settings: "wdth" 108;
  }

  tbody td {
    color: var(--ink-soft);
  }

  /* "tbody" outranks the scoped `tbody td` rules. */
  tbody .proof {
    width: 22%;
    color: var(--ledger);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .cell-label {
    display: none;
  }

  @media (max-width: 759px) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    tbody tr {
      display: grid;
      padding: 20px 0 22px 16px;
      border-bottom: 1px solid var(--rule);
    }

    tbody th,
    tbody td {
      width: auto;
      padding: 0;
      border: 0;
    }

    tbody td {
      margin-top: 14px;
    }

    /* Small and quiet, so a quick scan still lands on the problem first. */
    .cell-label {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 4px;
      color: var(--ink-soft);
      font-family: var(--font-sans);
      font-size: var(--step--1);
      font-weight: 600;
      font-variation-settings: "wdth" 100;
      letter-spacing: 0.01em;
      line-height: 1.3;
    }

    tbody .proof {
      justify-self: start;
      display: block;
      width: auto;
      margin-top: 12px;
      padding: 7px 10px;
      background: var(--ledger-tint);
      color: var(--ledger-deep);
      border-radius: 4px;
      font-weight: 600;
      font-size: 0.75rem;
      line-height: 1.3;
    }

    /* Inline, so a long proof wraps right after the label, not below it. */
    .proof .cell-label {
      display: inline-flex;
      margin: 0 6px 0 0;
      vertical-align: -2px;
      color: inherit;
      font-weight: 400;
      font-size: 0.8125rem;
      letter-spacing: 0;
    }
  }
</style>
