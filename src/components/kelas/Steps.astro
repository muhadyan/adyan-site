---
import { kelas } from "../../content/kelas";

const { steps } = kelas;
---

<section class="section" aria-labelledby="steps-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="steps-title">{steps.title}</h2>
    </div>
    <ol class="steps">
      {
        steps.items.map((step, i) => (
          <li>
            <span class="n num" aria-hidden="true">
              {i + 1}
            </span>
            <p>{step}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: 28px;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  li {
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }

  .n {
    color: var(--ledger);
    font-weight: 600;
    font-size: var(--step-1);
  }

  p {
    font-size: var(--step-1);
    line-height: 1.35;
  }
</style>
