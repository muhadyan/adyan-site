---
import { kelas } from "../../content/kelas";
import ApplyButton from "./ApplyButton.astro";
import Chips from "./Chips.astro";

const { hero } = kelas;
---

<section class="hero wrap" aria-labelledby="hero-title">
  <h1 id="hero-title">{hero.title}</h1>
  <p class="subtitle">{hero.subtitle}</p>
  <Chips />
  <ApplyButton spot="hero" />
</section>

<style>
  .hero {
    display: grid;
    justify-items: start;
    gap: 16px;
    /* Tight top so the Daftar button shows on first open, down to 360x640 phones. */
    padding-block: clamp(24px, 4vw, 64px) clamp(48px, 7vw, 96px);
  }

  h1 {
    font-size: clamp(2.5rem, 1.5rem + 4.4vw, 4.75rem);
    font-variation-settings: "wdth" 125;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .subtitle {
    max-width: 30rem;
    font-size: var(--step-1);
    line-height: 1.35;
  }
</style>
