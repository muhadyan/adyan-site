---
import { kelas } from "../../content/kelas";

const { trainer } = kelas;
---

<section class="section" aria-labelledby="trainer-title">
  <div class="wrap grid">
    <h2 id="trainer-title">{trainer.title}</h2>
    <p class="ruled"><strong>{trainer.name}</strong> {trainer.body}</p>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 64px;
    }
  }

  h2 {
    font-size: var(--step-3);
  }

  p {
    max-width: 36rem;
    font-size: var(--step-1);
    line-height: 1.45;
  }
</style>
