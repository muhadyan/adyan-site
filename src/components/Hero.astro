---
import { waLink } from "../config";
import type { Copy } from "../content/types";
import Receipt from "./Receipt.astro";
import WaIcon from "./WaIcon.astro";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const { hero } = copy;
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="text">
    <h1 id="hero-title">{hero.title}</h1>
    <p class="lede">{hero.lede}</p>
    <p class="proof">{hero.proof}</p>
    <div class="cta">
      <a
        class="button"
        href={waLink(copy.wa.message)}
        rel="noopener"
        target="_blank"
        data-umami-event="wa-click"
        data-umami-event-spot="hero"
      >
        <WaIcon />
        {hero.cta}
      </a>
      <p class="cta-note">{hero.ctaNote}</p>
    </div>
  </div>
  <Receipt receipt={hero.receipt} />
</section>

<style>
  .hero {
    /* The tilted receipt and its stamp must never cause sideways scroll. */
    overflow-x: clip;
    overflow-clip-margin: 8px;
    display: grid;
    gap: 56px;
    align-items: start;
    /* Tight top so the WhatsApp button shows on first open, down to 1366x768 laptops and 360x640 phones. */
    padding-block: clamp(20px, 3.2vw, 48px) clamp(64px, 9vw, 120px);
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 48px;
    }
  }

  @media (min-width: 1200px) {
    /* 380px slip + 16px for its tilt: receipt lines never wrap. */
    .hero {
      grid-template-columns: minmax(0, 1fr) 396px;
      gap: 64px;
    }
  }

  h1 {
    font-size: clamp(1.875rem, 1.2rem + 2.2vw, 3rem);
    font-variation-settings: "wdth" 125;
    line-height: 1.04;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  .lede {
    margin-top: clamp(14px, 1.5vw, 20px);
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.3125rem);
    line-height: 1.45;
    max-width: 34rem;
  }

  .proof {
    margin-top: 14px;
    padding-left: 16px;
    border-left: 3px double var(--ledger);
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.5;
    max-width: 34rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: clamp(20px, 2vw, 28px);
  }

  .cta-note {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }
</style>
