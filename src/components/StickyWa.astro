---
import { waLink } from "../config";
import WaIcon from "./WaIcon.astro";

interface Props {
  label: string;
  /** "mulai Rp2,5 jt" */
  price: string;
  wa: string;
  lane: string;
}

const { label, price, wa, lane } = Astro.props;
---

<a
  class="sticky-wa"
  href={waLink(wa)}
  rel="noopener"
  target="_blank"
  data-umami-event="wa-click"
  data-umami-event-spot="sticky"
  data-umami-event-lane={lane}
  hidden
>
  <span class="label"><WaIcon />{label}</span>
  <span class="price">{price}</span>
</a>

<script>
  import { stickyVisible } from "../lib/sticky";

  // Phones only (the bar is display:none from 720px). Shows once the hero button has
  // scrolled up out of view, hides again from the footer button down: never two at once.
  const bar = document.querySelector<HTMLElement>(".sticky-wa");
  const hero = document.querySelector(".hero .cta .button");
  const footer = document.querySelector(".footer .cta .button");
  if (bar && hero && footer && "IntersectionObserver" in window) {
    const state = { heroVisible: true, heroAbove: false, footerReached: false };
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.target === hero) {
          state.heroVisible = entry.isIntersecting;
          state.heroAbove = entry.boundingClientRect.bottom < 0;
        } else {
          // On screen, or already scrolled past it (address, map and links below).
          state.footerReached = entry.isIntersecting || entry.boundingClientRect.bottom < 0;
        }
      }
      bar.hidden = false;
      bar.toggleAttribute("data-shown", stickyVisible(state));
    });
    io.observe(hero);
    io.observe(footer);
  }
</script>

<style>
  .sticky-wa {
    position: fixed;
    inset: auto 0 0;
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    padding: 0 16px env(safe-area-inset-bottom);
    background: var(--ledger);
    border-top: 1px solid var(--ledger-deep);
    color: #fff;
    text-decoration: none;
    translate: 0 100%;
    visibility: hidden;
    transition:
      translate 240ms var(--ease-out),
      visibility 0s 240ms;
  }

  .sticky-wa[hidden] {
    display: none;
  }

  .sticky-wa[data-shown] {
    translate: 0 0;
    visibility: visible;
    transition: translate 240ms var(--ease-out);
  }

  .sticky-wa:active {
    background: var(--ledger-deep);
    color: #fff;
  }

  .label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }

  .price {
    color: var(--ledger-tint);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (min-width: 720px) {
    .sticky-wa {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-wa,
    .sticky-wa[data-shown] {
      translate: 0 0;
      transition: none;
    }
  }
</style>
