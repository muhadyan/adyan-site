---
import type { Copy } from "../content/types";

interface Props {
  faq: Copy["faq"];
}

const { faq } = Astro.props;
---

<section class="section" aria-labelledby="faq-title">
  <div class="wrap grid">
    <h2 id="faq-title">{faq.title}</h2>
    <div class="items">
      {
        faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 32px;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 64px;
    }
  }

  h2 {
    font-size: var(--step-3);
  }

  .items {
    border-top: 1px solid var(--ink);
  }

  details {
    border-bottom: 1px solid var(--rule);
  }

  summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font-weight: 650;
    font-size: var(--step-1);
    cursor: pointer;
    list-style: none;
    -webkit-user-select: none;
    user-select: none;
  }

  summary:active {
    color: var(--ledger-deep);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "+";
    flex: none;
    color: var(--ledger);
    font-family: var(--font-mono);
    transition: rotate 200ms var(--ease-out);
  }

  details[open] summary::after {
    rotate: 45deg;
  }

  details p {
    padding-bottom: 22px;
    max-width: 40rem;
    color: var(--ink-soft);
  }

  /* The answer settles in under its question instead of popping in. Closing stays instant. */
  details[open] p {
    animation: answer 200ms var(--ease-out) both;
  }

  @keyframes answer {
    from {
      opacity: 0;
      translate: 0 -4px;
    }
  }

  @keyframes answer-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    summary::after {
      transition: none;
    }

    details[open] p {
      animation-name: answer-fade;
    }
  }
</style>
