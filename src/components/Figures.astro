---
import type { Figure } from "../content/types";

interface Props {
  figures: Figure[];
  size?: "md" | "lg";
}

// Totals get the accountant's double underline.
const { figures, size = "md" } = Astro.props;
---

<dl class:list={["figures", size]}>
  {
    figures.map((f) => (
      <div>
        <dt class="visually-hidden">{f.label}</dt>
        <dd class="value num">{f.value}</dd>
        <dd class="label" aria-hidden="true">
          {f.label}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 20px 24px;
  }

  .value {
    display: inline-block;
    padding-bottom: 3px;
    border-bottom: 3px double var(--ink);
    font-weight: 600;
    font-size: var(--step-1);
    white-space: nowrap;
  }

  .lg .value {
    font-size: var(--step-2);
  }

  .label {
    margin-top: 8px;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.35;
  }
</style>
