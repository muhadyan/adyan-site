---
import { Image } from "astro:assets";
import type { Copy, Locale } from "../content/types";
import { LANE_SHOTS, lanePath } from "../data/lanes";
import { OFFERS, rupiah } from "../data/offers";
import { findShot } from "../data/work";

interface Props {
  lanes: Copy["lanes"];
  locale: Locale;
}

const { lanes, locale } = Astro.props;
---

<section class="lanes wrap" aria-labelledby="lanes-title">
  <h2 id="lanes-title">{lanes.title}</h2>
  <ul>
    {
      lanes.items.map((lane) => {
        const shot = findShot(LANE_SHOTS[lane.slug][0])!;
        const extra = lane.packages.slice(1);
        return (
          <li>
            <a
              class="card"
              href={lanePath(lane.slug, locale)}
              data-umami-event="lane-open"
              data-umami-event-lane={lane.slug}
            >
              <div class="shot">
                <div class="phone-frame">
                  <Image src={shot.image} alt="" widths={[200, 400]} sizes="200px" loading="lazy" />
                </div>
              </div>
              <div class="body">
                <h3>{lane.card.title}</h3>
                <p class="what">{lane.card.body}</p>
                <p class="price">
                  <span class="from">{lanes.from}</span>
                  <span class="total">{rupiah(OFFERS[lane.packages[0]!.offer].from, locale)}</span>
                </p>
                {extra.map((p) => (
                  <p class="extra num">
                    {p.title} {lanes.from} {rupiah(OFFERS[p.offer].from, locale)}
                  </p>
                ))}
                <span class="more">{lane.card.cta}</span>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .lanes {
    padding-bottom: clamp(48px, 7vw, 80px);
  }

  h2 {
    font-size: var(--step-3);
    max-width: 22ch;
  }

  ul {
    display: grid;
    gap: 16px;
    margin-top: clamp(20px, 3vw, 28px);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--slip);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition: transform 160ms var(--ease-out);
  }

  .card:active {
    transform: scale(0.98);
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      border-color: var(--ledger);
      color: var(--ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:active {
      transform: none;
    }
  }

  .shot {
    display: flex;
    justify-content: center;
    height: 200px;
    padding-top: 24px;
    overflow: hidden;
    background: var(--paper-deep);
  }

  @media (min-width: 900px) {
    .shot {
      height: 236px;
    }
  }

  .shot .phone-frame {
    width: 180px;
    height: 300px;
  }

  .body {
    display: grid;
    align-content: start;
    gap: 6px;
    flex: 1;
    padding: 16px 16px 20px;
  }

  h3 {
    font-size: 1.3125rem;
  }

  .what {
    color: var(--ink-soft);
  }

  .price {
    display: grid;
    justify-items: start;
    margin-top: 8px;
  }

  .from {
    color: var(--ink-soft);
    font-size: 0.84375rem;
  }

  .price .total {
    font-size: 1.375rem;
  }

  .extra {
    margin-top: 4px;
    font-size: 0.875rem;
  }

  .more {
    margin-top: 10px;
    color: var(--ledger);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
