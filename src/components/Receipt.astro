---
import type { Copy } from "../content/types";

interface Props {
  receipt: Copy["hero"]["receipt"];
}

const { receipt } = Astro.props;
---

<figure class="slip" aria-label={receipt.heading}>
  <div class="paper">
    <p class="head">{receipt.heading}</p>
    <p class="meta"><span>{receipt.number}</span><span>{receipt.to}</span></p>
    <ul class="lines">
      {
        receipt.lines.map((line) => (
          <li>
            <span>{line}</span>
            <span class="tick" aria-hidden="true">
              ✓
            </span>
          </li>
        ))
      }
    </ul>
    <p class="total"><span>{receipt.totalLabel}</span><span>{receipt.total}</span></p>
    <p class="thanks">{receipt.thanks}</p>
    <p class="stamp" aria-hidden="true">{receipt.stamp}</p>
  </div>
</figure>

<style>
  .slip {
    position: relative;
    width: min(calc(100% - 16px), 380px);
    margin-inline: auto;
    rotate: 1.5deg;
    filter: drop-shadow(0 1px 0 rgb(27 36 32 / 0.08)) drop-shadow(0 18px 28px rgb(27 36 32 / 0.12));
  }

  .paper {
    position: relative;
    padding: 28px 24px 96px;
    background: var(--slip);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--ink);
    /* Torn thermal-paper edge along the bottom. */
    --tooth: 10px;
    mask:
      conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / calc(2 * var(--tooth)) 100%;
    animation: print 1100ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .head {
    font-weight: 600;
    font-size: 0.9rem;
    text-align: center;
  }

  .meta,
  .total {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .meta {
    margin-top: 6px;
    padding-bottom: 12px;
    color: var(--ink-soft);
    border-bottom: 1px dashed var(--ink-soft);
  }

  .lines {
    display: grid;
    gap: 6px;
    padding: 14px 0;
    list-style: none;
    border-bottom: 1px dashed var(--ink-soft);
  }

  .lines li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .tick {
    color: var(--ledger);
    font-weight: 600;
  }

  .total {
    padding-top: 14px;
    font-weight: 600;
    font-size: 0.86rem;
  }

  .thanks {
    margin-top: 22px;
    color: var(--ink-soft);
    text-align: center;
  }

  .stamp {
    position: absolute;
    right: 24px;
    bottom: 34px;
    padding: 6px 12px;
    border: 2px solid var(--stamp);
    border-radius: 4px;
    outline: 1px solid var(--stamp);
    outline-offset: 2px;
    color: var(--stamp);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    rotate: -9deg;
    opacity: 0.88;
    mix-blend-mode: multiply;
    animation: stamp 260ms 1150ms cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }

  @keyframes print {
    from {
      clip-path: inset(0 0 100% 0);
      translate: 0 -24px;
    }
    to {
      clip-path: inset(0 0 0 0);
      translate: 0 0;
    }
  }

  @keyframes stamp {
    from {
      opacity: 0;
      scale: 1.6;
    }
    to {
      opacity: 0.88;
      scale: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .paper,
    .stamp {
      animation: none;
    }
  }
</style>
