---
import { SITE, waLink } from "../config";
import { BUSINESS } from "../data/business";
import type { Copy, Locale } from "../content/types";
import WaIcon from "./WaIcon.astro";

interface Props {
  locale: Locale;
  copy: Copy;
  paths: Record<Locale, string>;
  wa: string;
  lane: string;
}

const { locale, copy, paths, wa, lane } = Astro.props;
const langs: { code: Locale; label: string }[] = [
  { code: "id", label: "ID" },
  { code: "en", label: "EN" },
];
---

<a class="skip" href="#main">{copy.nav.skip}</a>
<header class="header">
  <div class="wrap header-inner">
    <a class="name" href={locale === "id" ? "/" : "/en/"}>
      {SITE.name}<span class="brand"> · {BUSINESS.name}</span>
    </a>
    <nav class="tools" aria-label={copy.nav.langLabel}>
      <ul class="langs">
        {
          langs.map((lang) => (
            <li>
              <a
                href={paths[lang.code]}
                hreflang={lang.code}
                lang={lang.code}
                aria-current={lang.code === locale ? "page" : undefined}
              >
                {lang.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        class="header-cta"
        href={waLink(wa)}
        rel="noopener"
        target="_blank"
        data-umami-event="wa-click"
        data-umami-event-spot="header"
        data-umami-event-lane={lane}
      >
        <WaIcon />
        {copy.nav.contact}
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
  }

  @media (min-width: 720px) {
    .header-inner {
      min-height: 64px;
    }
  }

  .name {
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 700;
    font-variation-settings: "wdth" 118;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (min-width: 720px) {
    .name {
      font-size: var(--step-0);
    }
  }

  .brand {
    color: var(--ink-soft);
    font-weight: 500;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .langs {
    display: flex;
    gap: 2px;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .langs a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    min-height: 36px;
    color: var(--ink-soft);
    text-decoration: none;
    border-radius: 4px;
  }

  .langs a:active,
  .langs a[aria-current="page"] {
    color: var(--ink);
    background: var(--paper-deep);
  }

  /* Phones get the sticky bottom bar instead, so the header stays one quiet line. */
  .header-cta {
    display: none;
  }

  @media (min-width: 720px) {
    .header-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 40px;
      padding: 0 16px;
      border: 1px solid var(--ledger);
      border-radius: var(--radius);
      font-size: 0.9375rem;
      font-weight: 600;
      text-decoration: none;
      transition: transform 160ms var(--ease-out);
    }

    .header-cta:active {
      transform: scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-cta:active {
      transform: none;
    }
  }
</style>
